  {"id":"math-q-8","subject":"math","level":"Qiyin","topic":"Algebra","question":"x² - 49 = 0 tenglamaning ildizlari qaysi?","options":["-7 va 7","7 va 0","-49 va 49","faqat 7"],"correctAnswer":"-7 va 7","explanation":"x² = 49 bo'lgani uchun x = 7 ham, x = -7 ham yechim bo'ladi."},
  {"id":"math-q-9","subject":"math","level":"Qiyin","topic":"Foiz","question":"Mahsulot narxi avval 20% oshdi, keyin esa 20% arzonlashdi. Dastlabki narx qanday o'zgardi?","options":["4% arzonlashdi","O'zgarmadi","4% oshdi","10% arzonlashdi"],"correctAnswer":"4% arzonlashdi","explanation":"100 → 120 (+20%), 120 ning 20% i = 24, 120 - 24 = 96. Demak 4% kamaydi."},
